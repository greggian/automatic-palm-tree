// ─────────────────────────────────────────────────────────────────────────────
// Common NHC Advisory Grammar Rules
//
// Shared tokens, envelope rules, and primitives used by all four product
// grammars (fstadv, discus, public, wndprb).
//
// This file is prepended to each product-specific *_rules.pest file by
// build.rs to produce the final grammar consumed by pest_derive.
//
// Key design notes:
// 1. All identifier/number tokens are ATOMIC (@{}) so that pest's implicit
//    WHITESPACE rule cannot skip spaces inside them, preventing greedy
//    over-matching across word boundaries.
// 2. Every line rule ends with a mandatory `nl` (it consumes its own line
//    ending).
// ─────────────────────────────────────────────────────────────────────────────

// Horizontal whitespace only (NOT newlines) — auto-inserted between tokens
WHITESPACE = _{ " " | "\t" }

// Explicit newline — used only where line structure matters
nl = _{ "\r\n" | "\n" | "\r" }

// ── Atomic token primitives ─────────────────────────────────────────────────

integer       = @{ ASCII_DIGIT+ }
decimal       = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? }
time_ref      = @{ ASCII_DIGIT{2} ~ "/" ~ ASCII_DIGIT{4} ~ "Z" }
lat           = @{ decimal ~ ("N" | "S") }
lon           = @{ decimal ~ ("E" | "W") }
cardinal      = @{ (ASCII_ALPHA_UPPER | "-")+ }
advisory_num  = @{ ASCII_DIGIT+ ~ ASCII_ALPHA_UPPER? }
storm_name    = @{ (ASCII_ALPHA_UPPER | ASCII_DIGIT | "-")+ }
storm_num_raw = @{ ASCII_DIGIT+ }
originator    = @{ ASCII_ALPHA_UPPER+ }
ddhhmm        = @{ ASCII_DIGIT{6} | "DDHHMM" }
issued_hhmm   = @{ ASCII_DIGIT{4} }
issued_day    = @{ ASCII_DIGIT{1,2} }
issued_year   = @{ ASCII_DIGIT{4} }

month_abbr = {
    "JAN" | "FEB" | "MAR" | "APR" | "MAY" | "JUN" |
    "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC"
}
day_of_week = {
    "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT" | "SUN"
}

// Longest-match first to avoid prefix ambiguity
status = {
    "POTENTIAL TROPICAL CYCLONE" |
    "POTENTIAL TROP CYCLONE"     |
    "POST-TROPICAL CYCLONE"      |
    "SUBTROPICAL STORM"          |
    "TROPICAL DEPRESSION"        |
    "TROPICAL CYCLONE"           |
    "TROPICAL STORM"             |
    "POST-TROPICAL"              |
    "REMNANTS OF"                |
    "REMNANT LOW"                |
    "HURRICANE"                  |
    "DISSIPATED"
}

// MIA = NHC Miami, HFO = CPHC Honolulu, NFD = Weather Prediction Center
awips_id      = { ("MIA" | "HFO" | "NFD") ~ product_code ~ basin_code ~ storm_num_raw }
product_code  = { "TCM" | "TCP" | "TCD" | "PWS" }
basin_code    = { "EP" | "AL" | "AT" | "CP" }

any_line = { (!nl ~ ANY)* ~ nl }

// ── Shared envelope rules ───────────────────────────────────────────────────

zczc_line       = { "ZCZC" ~ awips_id ~ "ALL" ~ ("CCA" | "CCB")? ~ nl }
wmo_header_line = { "TTAA00" ~ originator ~ ddhhmm ~ ("CCA" | "CCB")? ~ nl }
forecaster_line = { ^"Forecaster" ~ (!nl ~ ANY)* ~ nl? }
nws_line        = { "NWS" ~ (!nl ~ ANY)* ~ nl }
