// ─────────────────────────────────────────────────────────────────────────────
// NHC Forecast/Advisory (fstadv / TCM) — product-specific rules
// Prepended with common.pest by build.rs
// All numeric values are in knots and nautical miles as issued.
// ─────────────────────────────────────────────────────────────────────────────

// ── Top-level ───────────────────────────────────────────────────────────────

fstadv = {
    SOI ~
    zczc_line ~
    wmo_header_line ~
    nl* ~
    header_line ~
    nws_line ~
    ("ISSUED" ~ (!nl ~ ANY)* ~ nl)? ~  // optional "ISSUED BY..." sub-center line
    issued_line ~
    nl* ~
    ("CORRECTED" ~ (!nl ~ ANY)* ~ nl ~ nl*)? ~  // optional correction note
    position_line ~
    accuracy_line ~
    nl* ~
    movement_line ~
    skip_lines ~
    (
        pressure_line ~ skip_lines ~ wind_line ~ radii_line* |
        wind_line ~ radii_line* ~ skip_lines ~ pressure_line
    ) ~
    skip_lines ~
    repeat_position_line ~
    prev_position_line ~
    nl* ~
    forecast_block* ~
    (skip_lines ~ forecast_block+)* ~  // EXTENDED OUTLOOK blurb between forecast/outlook groups
    skip_lines ~                       // consumes "REQUEST FOR...", "THIS IS THE LAST...", etc.
    next_advisory_line? ~
    nl* ~
    "$$" ~ nl ~
    forecaster_line ~
    nl* ~ "NNNN" ~ nl* ~
    EOI
}

// ── Header ──────────────────────────────────────────────────────────────────

header_line = {
    status ~ storm_name ~
    ("SPECIAL FORECAST/ADVISORY" | "FORECAST/ADVISORY" | "SPECIAL ADVISORY" | "ADVISORY") ~
    "NUMBER" ~ advisory_num ~ (!nl ~ ANY)* ~ nl
}

// "1800 UTC WED JUL 09 2025"
issued_line = {
    issued_hhmm ~ "UTC" ~ day_of_week ~ month_abbr ~ issued_day ~ issued_year ~ nl
}

// ── Position / movement / pressure ──────────────────────────────────────────

position_line = {
    status? ~ "CENTER LOCATED NEAR" ~ lat ~ lon ~ "AT" ~ time_ref ~ nl
}

accuracy_line = { "POSITION ACCURATE WITHIN" ~ integer ~ "NM" ~ nl }

movement_line = {
    "PRESENT MOVEMENT TOWARD THE" ~ cardinal ~ "OR" ~
    integer ~ "DEGREES AT" ~ integer ~ "KT" ~ nl
}

pressure_line = { "ESTIMATED MINIMUM CENTRAL PRESSURE" ~ integer ~ "MB" ~ nl }

wind_line = {
    "MAX SUSTAINED WINDS" ~ integer ~ "KT WITH GUSTS TO" ~ integer ~ "KT" ~
    "."? ~ nl
}

radii_line = {
    radii_threshold ~ "KT" ~ "."+ ~
    radii_quad_ne ~ "NE" ~
    radii_quad_se ~ "SE" ~
    radii_quad_sw ~ "SW" ~
    radii_quad_nw ~ "NW" ~
    "."? ~ nl
}
radii_threshold = { "64" | "50" | "34" }
radii_quad_ne   = { integer }
radii_quad_se   = { integer }
radii_quad_sw   = { integer }
radii_quad_nw   = { integer }

repeat_position_line = {
    "REPEAT" ~ "."* ~ "CENTER LOCATED NEAR" ~ lat ~ lon ~ "AT" ~ time_ref ~ nl
}

prev_position_line = {
    "AT" ~ time_ref ~ "CENTER WAS LOCATED NEAR" ~ lat ~ lon ~ (!nl ~ ANY)* ~ nl
}

// ── Forecast blocks ─────────────────────────────────────────────────────────

forecast_block = {
    (forecast_valid_line | outlook_valid_line) ~
    forecast_wind_line? ~
    forecast_radii_line* ~
    nl*
}

forecast_valid_line = {
    "FORECAST VALID" ~ time_ref ~
    (lat ~ lon ~ (!nl ~ ANY)* | "."+ ~ (!nl ~ ANY)*) ~ nl
}

outlook_valid_line = {
    "OUTLOOK VALID" ~ time_ref ~
    (lat ~ lon ~ (!nl ~ ANY)* | "."+ ~ (!nl ~ ANY)*) ~ nl
}

forecast_wind_line = {
    "MAX WIND" ~ integer ~ "KT" ~ "."+ ~ "GUSTS" ~ integer ~ "KT" ~ "."? ~ nl
}

forecast_radii_line = {
    radii_threshold ~ "KT" ~ "."+ ~
    radii_quad_ne ~ "NE" ~
    radii_quad_se ~ "SE" ~
    radii_quad_sw ~ "SW" ~
    radii_quad_nw ~ "NW" ~
    "."? ~ nl
}

next_advisory_line = {
    "NEXT" ~ ("SPECIAL")? ~ "ADVISORY AT" ~ time_ref ~ nl
}

// Skip variable-content lines using negative lookaheads against anchors
skip_lines = _{
    (!(  "MAX SUSTAINED WINDS"
       | "ESTIMATED MINIMUM CENTRAL PRESSURE"
       | "REPEAT"
       | "AT " ~ time_ref ~ " CENTER"
       | "FORECAST VALID"
       | "OUTLOOK VALID"
       | "NEXT"
       | "$$"
    ) ~ any_line)*
}
