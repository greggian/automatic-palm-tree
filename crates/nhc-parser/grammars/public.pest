// ─────────────────────────────────────────────────────────────────────────────
// Common NHC Advisory Grammar Rules
//
// Shared tokens, envelope rules, and primitives used by all four product
// grammars (fstadv, discus, public, wndprb).
//
// This file is prepended to each product-specific *_rules.pest file by
// build.rs to produce the final grammar consumed by pest_derive.
//
// Key design notes:
// 1. All identifier/number tokens are ATOMIC (@{}) so that pest's implicit
//    WHITESPACE rule cannot skip spaces inside them, preventing greedy
//    over-matching across word boundaries.
// 2. Every line rule ends with a mandatory `nl` (it consumes its own line
//    ending).
// ─────────────────────────────────────────────────────────────────────────────

// Horizontal whitespace only (NOT newlines) — auto-inserted between tokens
WHITESPACE = _{ " " | "\t" }

// Explicit newline — used only where line structure matters
nl = _{ "\r\n" | "\n" | "\r" }

// ── Atomic token primitives ─────────────────────────────────────────────────

integer       = @{ ASCII_DIGIT+ }
decimal       = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? }
time_ref      = @{ ASCII_DIGIT{2} ~ "/" ~ ASCII_DIGIT{4} ~ "Z" }
lat           = @{ decimal ~ ("N" | "S") }
lon           = @{ decimal ~ ("E" | "W") }
cardinal      = @{ (ASCII_ALPHA_UPPER | "-")+ }
advisory_num  = @{ ASCII_DIGIT+ ~ ASCII_ALPHA_UPPER? }
storm_name    = @{ (ASCII_ALPHA_UPPER | ASCII_DIGIT | "-")+ }
storm_num_raw = @{ ASCII_DIGIT+ }
originator    = @{ ASCII_ALPHA_UPPER+ }
ddhhmm        = @{ ASCII_DIGIT{6} | "DDHHMM" }
issued_hhmm   = @{ ASCII_DIGIT{4} }
issued_day    = @{ ASCII_DIGIT{1,2} }
issued_year   = @{ ASCII_DIGIT{4} }

month_abbr = {
    "JAN" | "FEB" | "MAR" | "APR" | "MAY" | "JUN" |
    "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC"
}
day_of_week = {
    "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT" | "SUN"
}

// Longest-match first to avoid prefix ambiguity
status = {
    "POTENTIAL TROPICAL CYCLONE" |
    "POTENTIAL TROP CYCLONE"     |
    "POST-TROPICAL CYCLONE"      |
    "SUBTROPICAL STORM"          |
    "TROPICAL DEPRESSION"        |
    "TROPICAL CYCLONE"           |
    "TROPICAL STORM"             |
    "POST-TROPICAL"              |
    "REMNANTS OF"                |
    "REMNANT LOW"                |
    "HURRICANE"                  |
    "DISSIPATED"
}

// MIA = NHC Miami, HFO = CPHC Honolulu, NFD = Weather Prediction Center
awips_id      = { ("MIA" | "HFO" | "NFD") ~ product_code ~ basin_code ~ storm_num_raw }
product_code  = { "TCM" | "TCP" | "TCD" | "PWS" }
basin_code    = { "EP" | "AL" | "AT" | "CP" }

any_line = { (!nl ~ ANY)* ~ nl }

// ── Shared envelope rules ───────────────────────────────────────────────────

zczc_line       = { "ZCZC" ~ awips_id ~ "ALL" ~ ("CCA" | "CCB")? ~ nl }
wmo_header_line = { "TTAA00" ~ originator ~ ddhhmm ~ ("CCA" | "CCB")? ~ nl }
forecaster_line = { ^"Forecaster" ~ (!nl ~ ANY)* ~ nl? }
nws_line        = { "NWS" ~ (!nl ~ ANY)* ~ nl }

// ─────────────────────────────────────────────────────────────────────────────
// NHC Public Advisory (public / TCP) — product-specific rules
// Prepended with common.pest by build.rs
// Values are in mph and km/h as issued (not knots).
// ─────────────────────────────────────────────────────────────────────────────

// ── Top-level ───────────────────────────────────────────────────────────────

public_adv = {
    SOI ~
    zczc_line ~
    wmo_header_line ~
    nl* ~
    ("BULLETIN" ~ nl)? ~
    header_line ~
    nws_line ~
    ("ISSUED" ~ (!nl ~ ANY)* ~ nl)? ~
    issued_line ~
    nl* ~
    ("CORRECTED" ~ (!nl ~ ANY)* ~ nl ~ nl*)? ~  // optional correction note
    headline? ~
    (!"LOCATION" ~ any_line)* ~      // "SUMMARY OF..." header + dashes
    location_line ~
    (!"MAXIMUM" ~ any_line)* ~       // "ABOUT N MI..." distance lines (zero or more)
    wind_line ~
    movement_line ~
    pressure_line ~
    nl* ~
    body_prose ~
    next_advisory_section ~
    nl* ~
    "$$" ~ nl ~
    forecaster_line ~
    nl* ~ ("NNNN" ~ nl*)? ~
    EOI
}

// ── Header ──────────────────────────────────────────────────────────────────

header_line = {
    status ~ storm_name ~
    ("PUBLIC")? ~ ("SPECIAL")? ~ "ADVISORY" ~ "NUMBER" ~ advisory_num ~ (!nl ~ ANY)* ~ nl
}

// Issued time — UTC or local time, parsed as raw text in Rust.
issued_line = { (!nl ~ ANY)* ~ nl }

// "...FOUR-E BECOMES A TROPICAL STORM..."
headline      = { "..." ~ headline_text ~ "..." ~ nl }
headline_text = @{ (!(nl | "...") ~ ANY)+ }

// ── Summary block ───────────────────────────────────────────────────────────

location_line = { "LOCATION" ~ "..." ~ lat ~ lon ~ nl }

// "MAXIMUM SUSTAINED WINDS...45 MPH...75 KM/H"
wind_line = { "MAXIMUM SUSTAINED WINDS" ~ "..." ~ integer ~ "MPH" ~ "..." ~ integer ~ "KM/H" ~ nl }

// "PRESENT MOVEMENT...WNW OR 285 DEGREES AT 9 MPH...15 KM/H"
// "PRESENT MOVEMENT...STATIONARY"
movement_line = {
    "PRESENT MOVEMENT" ~ "..." ~
    (cardinal ~ "OR" ~ integer ~ "DEGREES AT" ~
     integer ~ "MPH" ~ "..." ~ integer ~ "KM/H" |
     "STATIONARY") ~ nl
}

// "MINIMUM CENTRAL PRESSURE...999 MB...29.50 INCHES"
pressure_line = {
    "MINIMUM CENTRAL PRESSURE" ~ "..." ~ integer ~ "MB" ~
    "..." ~ decimal ~ "INCHES" ~ nl
}

// ── Prose and next advisory ─────────────────────────────────────────────────

body_prose = { (!("NEXT ADVISORY" | "$$") ~ any_line)* }

next_advisory_section = {
    "NEXT ADVISORY" ~ nl ~
    ("-"+ ~ nl)? ~
    (!"$$" ~ any_line)*
}

// Gust line found inside body prose (extracted by Rust, not walked in grammar)
gust_capture = {
    "WITH GUSTS TO" ~ integer ~ "MPH" ~ "(" ~ integer ~ "KM/H" ~ ")" ~ "."?
}
